{
  "name": "side-notch",
  "version": "0.1.0",
  "description": "Dynamic Island-style overlay for Cursor agent tasks on Windows",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build && tsc -p tsconfig.electron.json && node scripts/copy-preload.mjs",
    "test:notifications": "npm run build && node --test scripts/notifications.test.mjs",
    "preview": "vite preview",
    "postinstall": "node scripts/run-electron.mjs --ensure-only",
    "electron:ensure": "node scripts/run-electron.mjs --ensure-only",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && tsc -p tsconfig.electron.json && node scripts/copy-preload.mjs && node scripts/run-electron.mjs --launch-only\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.sidenotch.app",
    "productName": "Side-notch",
    "asarUnpack": [
      "scripts/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^10.0.1"
  },
  "devDependencies": {
    "@electron/get": "^2.0.3",
    "@types/auto-launch": "^5.0.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
